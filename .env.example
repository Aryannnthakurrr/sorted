# Copy to .env. Set at least one of OPENAI_API_KEY / CEREBRAS_API_KEY.
OPENAI_API_KEY=
CEREBRAS_API_KEY=
TINYFISH_API_KEY=
TELEGRAM_BOT_TOKEN=

# LLM routes. Model IDs verified with client.models.list() on 2026-10-14:
#   cerebras: gpt-oss-120b, qwen-3.8-27b
#   openai:   gpt-5.x family (gpt-5.4, gpt-5.4-mini, gpt-5.5, ...), gpt-4.1*, gpt-4o*
# Small/fast route: classification fallback, extraction, chat answers (high volume -> Cerebras).
BRAIN_SMALL_PROVIDER=cerebras
BRAIN_SMALL_MODEL=gpt-oss-120b
# Strong route: compiler agent writing code + tests, and repair.
BRAIN_STRONG_PROVIDER=openai
BRAIN_STRONG_MODEL=gpt-5.4
# Used when a route's provider has no key and we fall back to the other provider.
BRAIN_OPENAI_FALLBACK_MODEL=gpt-5.4-mini
BRAIN_CEREBRAS_FALLBACK_MODEL=gpt-oss-120b

# Token budgets (when exceeded, tasks are queued instead of failing)
BRAIN_RUN_TOKEN_BUDGET=20000
BRAIN_DAY_TOKEN_BUDGET=500000

# Compiler / classifier
BRAIN_COMPILE_AFTER=3
BRAIN_SHADOW_RUNS=2
BRAIN_CLASSIFIER_THRESHOLD=0.7

# Scheduler
BRAIN_QUIET_HOURS=22-07

# State store (default: sqlite file at data/brain.db)
# BRAIN_DB_URL=sqlite:///data/brain.db

# TinyFish: 0 = replay recorded Agent API responses, 1 = live calls (uses credits)
TINYFISH_LIVE=0
